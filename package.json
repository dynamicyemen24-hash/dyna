{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "og-image": "powershell -ExecutionPolicy Bypass -File scripts/make-og-image.ps1",
    "assets": "npm run icons && npm run og-image",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist-server/server.mjs --external:pg-native --external:@vitejs/devtools/* --external:lightningcss",
    "start": "tsx server.ts",
    "start:prod": "cross-env NODE_ENV=production tsx server.ts",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "verify": "npm run lint && npm run build",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:status": "tsx scripts/migrate.ts --status",
    "preview": "vite preview --port 3000",
    "release:credentials": "tsx scripts/release-credentials.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:api": "tsx scripts/apitest.ts",
    "test:screens": "tsx scripts/screens-e2e.ts",
    "test:primitives": "tsx scripts/test-primitives.ts",
    "test:yemen": "tsx scripts/test-yemen.ts",
    "test:kpi": "tsx scripts/test-kpi.ts",
    "test:mfa": "tsx scripts/test-mfa.ts",
    "test:unlock": "tsx scripts/test-unlock.ts",
    "test:tenant": "tsx scripts/test-tenant-isolation.ts",
    "test:mtlogin": "tsx scripts/test-multi-tenant-login.ts",
    "test:price": "tsx scripts/test-price-authority.ts",
    "test:theme": "tsx scripts/test-theme-activation.ts",
    "test:gate": "tsx scripts/test-session-gate.ts",
    "test:docnum": "tsx scripts/test-document-number.ts",
    "test:financials": "tsx scripts/test-financials.ts",
    "test:encoding": "tsx scripts/test-encoding.ts",
    "deploy": "npm run build && npm run deploy:api",
    "deploy:api": "wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
