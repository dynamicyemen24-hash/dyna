# ---------------------------------------------------------------------------------------
# DyPOS Cloud — environment (secrets in Workers KV/secrets, never committed)
# ---------------------------------------------------------------------------------------

# Neon Serverless PostgreSQL connection string.
# Format: postgresql://user:password@host/database?sslmode=require
#
# ══ NEVER WRITE A REAL CREDENTIAL IN THIS FILE ═══════════════════════════
# `.env.example` IS TRACKED BY GIT: anything written here is published to every
# collaborator with clone access. Secrets live in exactly two places:
#   - local dev: the untracked `.env` (see .gitignore)
#   - production: the Worker secret store (`npx wrangler secret put DATABASE_URL`)
# A previously committed owner credential (`npg_ATh…`) is therefore considered
# COMPROMISED: rotate it in the Neon console and past deployments keep serving
# only until the rotation lands.
DATABASE_URL=""

# Session signing secret (32+ bytes of random hex). Generated at deployment.
DYPOS_SESSION_SECRET=""

# Enable MFA for every user (default: off). Per-user enrolment via `dypos.mfa_secrets.enabled`.
# DYPOS_MFA_REQUIRED="true"

# Rate limiting budgets per IP per route (Express + edge).
# DYPOS_AUTH_RATE_WINDOW_MS="300000"   # default
# DYPOS_AUTH_RATE_MAX_FAILURES="15"    # default
# DYPOS_AUTH_RATE_MAX_REQUESTS="120"   # default

# Payment gateway (server-side integration only; never a VITE_ variable).
# VITE_PAYMENT_GATEWAY="moyasar" | "stripe" | "sarie_bank_transfer" | "stc_pay"

# Default tenant for unbucketed requests (set in `wrangler.toml` [vars]).
DEFAULT_TENANT="royal-global-hq"

# Application name (set in `wrangler.toml` [vars]).
APP_NAME="DyPOS — نظام إدارة الأعمال والمبيعات"

# Customer-facing origin (used for self-referential links, OAuth callbacks, CSP).
# Must match the Cloudflare custom domain bound to the Worker.
APP_URL="https://dyposcloud.smartportssoft.com"

# --- Emergency access (break-glass) ---
# Supervisor with `auth.break_glass` only; single-use, expiring, audited grants.
# No magic passcode exists.

# Infrastructure hints (generated at deploy time).
WORKER_NAME="dyposcloud"
DEPLOYMENT_ALIAS="https://dyposcloud.smartportssoft.com"

