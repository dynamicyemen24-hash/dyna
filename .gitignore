node_modules/
build/
dist/
dist-server/
coverage/
.DS_Store

# ── Operational debris ─────────────────────────────────────────────────────
# `*.log` alone was not enough. The root accumulated apitest.log, audit.log,
# build.log, columns.log, server.log, srv.log … but also `col.out`, `mig.err`,
# `strict.out` and `ping.out` — the same debris under `.out` / `.err`
# extensions. `.gitignore` matched the first three letters and let the rest in,
# so a red `tsc` run left a committed failure log behind. Output debris now
# needs three patterns, not one.
*.log
*.out
*.err

# Wrangler's local state and the dry-run bundle it caches.
.wrangler/
.wrangler-dry/

# End-to-end / scratch run artifacts produced by the scripts in `scripts/`.
screens-e2e.out
e2e.out

# One-off operational probes. A previous `.dbping.cjs` lived in the project
# root, read a real `DATABASE_URL`, applied migration v137 directly and then
# wrote to `dypos.applied_migrations` by hand — bypassing `scripts/migrate.ts`
# entirely. It is exactly the kind of script that must never be committed: it
# can mark a migration applied when only part of it ran, and the ledger then
# says "done" forever. Probes belong in `scripts/`, reviewed, or nowhere.
.dbping.*

.env*
!.env.example

# Scratch artifacts. These are operational debris, never source, and one of them
# (.tmp_pw) held a 20-character plaintext credential in the project root — a
# secret has no business being in a tree at all. The pattern is ignored as well
# as deleted so the next one cannot be committed by accident.
.tmp*
*.tmp
scratch/

# ── Agent / tool state, never source ────────────────────────────────────────
# Orchestrator and editor-tool directories that live in the project root but
# belong to the tool, not the product:
#
#   .gsee/   — per-project orchestrator state (state map, checkpoints, handover,
#              intel). It holds decisions about THIS checkout only, so committing
#              it would ship one machine's working memory to every clone — and
#              its audit log is append-only noise in every diff.
#   .kilo/   — a tool's own worktrees. The gate's data-integrity scan read a
#              full duplicate of `server/migrations/` from
#              `.kilo/worktrees/<name>/` and flagged ITS destructive SQL as if
#              this repository shipped it — a foreign copy reporting on us.
#   .manus/  — MCP result cache.
#   .work/   — tool scratch, 91 MB at the time of writing, including a bundled
#              `tools/node.exe`. A runtime binary in a source tree is exactly
#              what `dist/` and `node_modules/` rules already exist to exclude.
#   outputs/ — generated reports.
#
# The pattern is ignored rather than deleted for the last three because those
# directories are owned by running tools: deleting them out from under the tool
# loses its state, ignoring them keeps the tree honest.
.gsee/
.kilo/
.manus/
.work/
outputs/
