  return (
    <div className="max-w-7xl mx-auto space-y-10 animate-in fade-in zoom-in-95 duration-700">
      {/* AI Search & Strategy Bar */}
      <div className="bg-gradient-to-r from-indigo-600/20 via-purple-600/20 to-brand-600/20 p-8 rounded-[2.5rem] border border-white/5 relative overflow-hidden">
        <div className="absolute inset-0 bg-grid-white/[0.02] bg-[size:32px_32px]"></div>
        <div className="relative z-10 flex flex-col items-center text-center space-y-6">
          <div className="bg-white/10 p-4 rounded-full backdrop-blur-xl border border-white/10 animate-pulse">
            <BrainCircuit size={40} className="text-indigo-400" />
          </div>
          <div className="space-y-2">
            <h1 className="text-4xl font-black tracking-tight text-white">مركز الذكاء التنفيذي (DyPOS AI)</h1>
            <p className="text-slate-400 max-w-xl mx-auto">اسأل أي سؤال حول مبيعاتك، مخزونك، أو أداء موظفيك وسيقوم الذكاء الاصطناعي بتحليل البيانات العميقة فوراً.</p>
          </div>
          <div className="w-full max-w-2xl relative">
            <Search className="absolute right-6 top-1/2 -translate-y-1/2 text-indigo-400" size={24} />
            <input 
              type="text" 
              placeholder="مثال: قارن بين أداء الفروع في عطلة نهاية الأسبوع الماضية..." 
              className="w-full bg-white/5 border border-white/10 rounded-2xl py-5 pr-16 pl-6 text-lg focus:ring-4 focus:ring-indigo-500/20 transition-all outline-none backdrop-blur-md"
            />
            <button 
              onClick={triggerAnalysis}
              className="absolute left-3 top-1/2 -translate-y-1/2 bg-indigo-600 hover:bg-indigo-500 text-white px-6 py-2.5 rounded-xl font-bold flex items-center gap-2 transition-all"
            >
              <Sparkles size={18} />
              تحليل
            </button>
          </div>
        </div>
      </div>

      {/* AI Insights & Alerts */}
      {aiInsight && (
        <div className="bg-indigo-600/10 border border-indigo-500/30 p-6 rounded-3xl flex gap-6 animate-in slide-in-from-top-4 duration-500">
          <div className="p-3 bg-indigo-600 rounded-2xl h-fit">
            <Sparkles size={24} className="text-white" />
          </div>
          <div className="space-y-3">
            <h4 className="font-black text-indigo-400 flex items-center gap-2">
              توصية استراتيجية فورية
              <span className="bg-indigo-500/20 text-indigo-300 text-[10px] px-2 py-0.5 rounded-full uppercase tracking-widest font-black">AI Generated</span>
            </h4>
            <p className="text-slate-200 leading-relaxed font-medium">{aiInsight}</p>
            <div className="flex gap-4 pt-2">
              <button className="text-xs font-black bg-indigo-600 px-4 py-2 rounded-lg hover:bg-indigo-500 transition-colors">تنفيذ الإجراء الآن</button>
              <button className="text-xs font-black bg-slate-800 px-4 py-2 rounded-lg hover:bg-slate-700 transition-colors">إهمال</button>
            </div>
          </div>
        </div>
      )}

      {/* Enterprise Metrics Matrix */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <MetricCard label="صافي الربح" value="45,200.00 ر.س" trend={18} sub="معدل نمو مستقر منذ مطلع الشهر" />
        <MetricCard label="السيولة النقدية" value="128,400.00 ر.س" trend={-2} sub="انخفاض طفيف بسبب مشتريات المخزون" />
        <MetricCard label="الذمم المدينة" value="12,500.00 ر.س" trend={-15} sub="تحصيل ممتاز من عملاء الآجل" />
        <MetricCard label="معدل دوران المخزون" value="4.2x" trend={5} sub="تحسن في سرعة بيع الفئات الرئيسية" />
      </div>

      {/* Deep Analytics Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div className="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-[2rem] p-8 space-y-8">
          <div className="flex justify-between items-center">
            <div className="flex items-center gap-4">
              <div className="p-3 bg-brand-500/10 rounded-2xl text-brand-400">
                <BarChart3 size={24} />
              </div>
              <div>
                <h3 className="text-xl font-black">تحليل العائد على الاستثمار</h3>
                <p className="text-sm text-slate-500">مقارنة بين تكلفة البضاعة والمبيعات الإجمالية</p>
              </div>
            </div>
            <select className="bg-slate-800 border-none rounded-xl text-xs font-bold py-2 px-4 focus:ring-2 focus:ring-brand-500/50">
              <option>آخر 3 أشهر</option>
              <option>هذا العام</option>
            </select>
          </div>
          
          <div className="h-64 flex items-end justify-between gap-2">
            {[65, 45, 85, 30, 95, 70, 50, 80, 40, 60, 90, 55].map((h, i) => (
              <div key={i} className="flex-1 group relative">
                <div 
                  style={{ height: `${h}%` }} 
                  className="bg-indigo-600/20 group-hover:bg-indigo-500/40 rounded-t-lg transition-all duration-500"
                ></div>
                <div 
                  style={{ height: `${h * 0.7}%` }} 
                  className="bg-brand-500/40 group-hover:bg-brand-500 rounded-t-lg transition-all duration-700 absolute bottom-0 left-0 right-0"
                ></div>
                <div className="absolute -top-10 left-1/2 -translate-x-1/2 bg-slate-800 px-2 py-1 rounded text-[10px] font-bold opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                  {h}% Growth
                </div>
              </div>
            ))}
          </div>
          
          <div className="flex justify-between text-[10px] font-black text-slate-600 uppercase tracking-widest pt-4">
            <span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span>
            <span>Jul</span><span>Aug</span><span>Sep</span><span>Oct</span><span>Nov</span><span>Dec</span>
          </div>
        </div>

        <div className="space-y-8">
          <div className="bg-slate-900 border border-slate-800 rounded-[2rem] p-8">
            <h3 className="text-xl font-black mb-6 flex items-center gap-2">
              <PieChart size={20} className="text-blue-400" />
              توزع المبيعات حسب الفئة
            </h3>
            <div className="space-y-4">
              {[
                { name: 'ملابس جاهزة', value: 45, color: 'bg-indigo-500' },
                { name: 'تفصيل خياطة', value: 30, color: 'bg-brand-500' },
                { name: 'إكسسوارات', value: 15, color: 'bg-amber-500' },
                { name: 'أخرى', value: 10, color: 'bg-slate-600' },
              ].map(item => (
                <div key={item.name} className="space-y-1.5">
                  <div className="flex justify-between text-xs font-bold">
                    <span>{item.name}</span>
                    <span>{item.value}%</span>
                  </div>
                  <div className="h-2 bg-slate-800 rounded-full overflow-hidden">
                    <div style={{ width: `${item.value}%` }} className={`h-full ${item.color}`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div className="bg-brand-600/10 border border-brand-500/20 p-8 rounded-[2rem] flex flex-col items-center text-center">
            <ShieldCheck size={48} className="text-brand-500 mb-4" />
            <h4 className="font-black text-lg mb-2">سلامة البيانات والامتثال</h4>
            <p className="text-xs text-slate-400 leading-relaxed mb-6">قاعدة بيانات Neon مؤمنة بالكامل ومتوافقة مع متطلبات الفوترة الإلكترونية للمرحلة الثانية (ZATCA الربط والكامل).</p>
            <button className="w-full bg-brand-600 hover:bg-brand-500 py-3 rounded-xl text-sm font-black transition-all">
              تصدير سجل الامتثال
            </button>
          </div>
        </div>
      </div>
